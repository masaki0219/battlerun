{
  "name": "battlerun",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "ts-node --project tests/tsconfig.json tests/unit.test.ts",
    "test:localization": "ts-node --project tests/tsconfig.json tests/localizationMarket.test.ts",
    "test:aggregation": "firebase emulators:exec --only firestore \"ts-node --project tests/tsconfig.json tests/activityAggregation.integration.ts\"",
    "test:e2e": "cd functions && npm run build && cd .. && firebase emulators:exec --project demo-zelio --only firestore,auth,functions \"ts-node --project tests/tsconfig.json tests/recordReflection.e2e.ts\"",
    "test:e2e:scenarios": "cd functions && npm run build && cd .. && firebase emulators:exec --project demo-zelio --only firestore,auth,functions \"ts-node --project tests/tsconfig.json tests/releaseScenarios.e2e.ts\"",
    "gps:replay": "ts-node scripts/replay-gps-log.ts",
    "test:ui:emulators": "firebase emulators:start --project demo-zelio --only firestore,auth,functions",
    "test:ui:seed": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 GCLOUD_PROJECT=zelio-run ts-node --project tests/tsconfig.json tests/seedUiEmulator.ts",
    "test:ui:app": "EXPO_PUBLIC_USE_FIREBASE_EMULATOR=1 expo start --go --ios --port 8082",
    "test:ui": "maestro test .maestro/",
    "test:rules": "firebase emulators:exec --only firestore \"ts-node --project tests/tsconfig.json tests/firestore-rules.test.ts\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-firebase/app": "^26.1.0",
    "@react-native-firebase/auth": "^26.1.0",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-background-fetch": "~14.0.9",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sensors": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "firebase": "~10.14.1",
    "i18n-js": "^4.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-nitro-google-signin": "^1.3.0",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-purchases": "^10.1.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-worklets": "^0.5.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "~3.0.4",
    "@types/node": "^25.8.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "firebase-admin": "^13.10.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-google-signin"
        ]
      }
    }
  }
}
