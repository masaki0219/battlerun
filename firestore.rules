rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed data model (client-visible collections)
    // ===============================================================
    // users/{uid}: private profile, plan/role, totals, memberships and settings.
    //   Owner/admin read; client may create its own free profile and update only settings.
    // users/{uid}/{notifications|badges|monthlyStats|activityRoutes|blocks}: private owner data.
    // publicProfiles/{uid}: signed-in users may read the bounded public name/avatar projection.
    // seasons/{id}: signed-in read, admin write.
    // battles/{id}: public challenges are signed-in readable; private challenges are limited to
    //   creator/admin/participants. Private creation and participation use Callable Functions.
    // battles/{id}/{participants|category_stats|presence|declarations}: battle-scoped data.
    // activities/{id}: authoritative activity, exact times, memberships and aggregation metadata;
    //   owner/admin read only. Authorized social views receive a server-sanitized projection.
    // activities/{id}/reactions/{uid}: readable/writable only to an authorized viewer of a battle
    //   credited by the parent activity (or the activity owner/admin).
    // battleInviteCodes/{code}: server-only uniqueness reservation.
    // contentReports/{id}: authenticated create, admin read/review.
    // All unspecified paths are denied by default.
    // ===============================================================

    function isAuthenticated() { return request.auth != null; }
    function signedIn() { return isAuthenticated(); }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isSelf(uid) { return isOwner(uid); }
    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }
    function isAdmin() {
      return signedIn() && userDoc(request.auth.uid).data.get('role', '') == 'admin';
    }
    function safeUserText(text) {
      return text is string
        && !text.matches('.*(死ね|しねよ|消えろ|殺すぞ|ころすぞ|ぶっ殺す|レイプ|輪姦|児童ポルノ|援助交際|パパ活募集|ママ活募集).*');
    }
    function hasBlockBetween(firstUid, secondUid) {
      return exists(/databases/$(database)/documents/users/$(firstUid)/blocks/$(secondUid))
        || exists(/databases/$(database)/documents/users/$(secondUid)/blocks/$(firstUid));
    }
    function isBattleParticipant(battleId) {
      return signedIn()
        && exists(/databases/$(database)/documents/battles/$(battleId)/participants/$(request.auth.uid));
    }
    function validWeeklyGoal(goal) {
      return goal == null || (
        goal is map
        && goal.keys().hasOnly(['type', 'value'])
        && goal.type in ['distance', 'days']
        && goal.value is number
        && (
          (goal.type == 'distance' && goal.value >= 1 && goal.value <= 500)
          || (goal.type == 'days' && goal.value is int && goal.value >= 1 && goal.value <= 7)
        )
      );
    }
    function validRunningPresenceSetting(data) {
      return !('runningPresenceVisible' in data)
        || data.runningPresenceVisible is bool;
    }
    function validRunDeclarationSetting(data) {
      return !('runDeclarationVisible' in data)
        || data.runDeclarationVisible is bool;
    }
    function isSameBattleCategory(battleId, categoryId) {
      let participantPath = /databases/$(database)/documents/battles/$(battleId)/participants/$(request.auth.uid);
      return signedIn()
        && categoryId is string
        && exists(participantPath)
        && get(participantPath).data.get('categoryId', '') == categoryId;
    }
    function validDeclarationV2(data, declarationId) {
      return data.keys().hasOnly([
          'uid', 'categoryId', 'dateKey', 'timezone', 'plannedAt', 'note',
          'status', 'visible', 'createdAt', 'expireAt'
        ])
        && data.keys().hasAll([
          'uid', 'categoryId', 'dateKey', 'timezone', 'plannedAt',
          'status', 'visible', 'createdAt', 'expireAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.categoryId is string
        && data.categoryId.size() >= 1
        && data.categoryId.size() <= 128
        && data.dateKey is string
        && data.dateKey.matches('^[0-9]{8}$')
        && declarationId == data.uid + '_' + data.dateKey
        && data.timezone is string
        && data.timezone.size() <= 64
        && data.plannedAt is timestamp
        && data.get('note', '') is string
        && data.get('note', '').size() <= 20
        && safeUserText(data.get('note', ''))
        && data.status in ['planned', 'done', 'cancelled']
        && data.visible is bool
        && data.createdAt is timestamp
        && data.expireAt is timestamp;
    }
    function validFreshDeclarationV2(data, declarationId, battleId) {
      return validDeclarationV2(data, declarationId)
        && data.uid == request.auth.uid
        && isSameBattleCategory(battleId, data.categoryId)
        && userDoc(request.auth.uid).data.get('runDeclarationVisible', false) == true
        && data.plannedAt >= request.time - duration.value(5, 'm')
        && data.plannedAt <= request.time + duration.value(24, 'h')
        && data.status == 'planned'
        && data.visible == true
        && data.createdAt == request.time
        && data.expireAt >= request.time + duration.value(47, 'h')
        && data.expireAt <= request.time + duration.value(49, 'h');
    }
    function validLegacyDeclaration(data, declarationId) {
      return data.keys().hasOnly([
          'uid', 'dateKey', 'timezone', 'plannedAt', 'note', 'status', 'createdAt'
        ])
        && data.keys().hasAll(['uid', 'dateKey', 'plannedAt', 'status', 'createdAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.dateKey is string
        && data.dateKey.matches('^[0-9]{8}$')
        && declarationId == data.uid + '_' + data.dateKey
        && data.get('timezone', '') is string
        && data.get('timezone', '').size() <= 64
        && data.plannedAt is timestamp
        && data.get('note', '') is string
        && data.get('note', '').size() <= 20
        && safeUserText(data.get('note', ''))
        && data.status in ['planned', 'done', 'cancelled']
        && data.createdAt is timestamp;
    }
    function canReadDeclaration(battleId, data) {
      return signedIn() && (
        data.uid == request.auth.uid
        || isAdmin()
        || (
          validDeclarationV2(data, data.uid + '_' + data.dateKey)
          && data.visible == true
          && data.expireAt > request.time
          && isSameBattleCategory(battleId, data.categoryId)
        )
      );
    }
    function validExpoPushToken(data) {
      return !('expoPushToken' in data)
        || data.expoPushToken == null
        || (data.expoPushToken is string && data.expoPushToken.size() <= 512);
    }
    function validAvatarEmoji(data) {
      return data.get('avatarEmoji', null) in [
        null,
        '🐱', '🐶', '🐻', '🐼', '🐨', '🐯', '🦁', '🐸',
        '🐰', '🐹', '🦊', '🐺', '🐮', '🐷', '🐧', '🐬',
        '🦄', '🦔', '🦋', '🦦', '🐙', '🦈', '🐘', '🦒',
        '🏃', '🚶', '⚽', '🏀', '🏈', '⚾', '🎾', '🏐',
        '🏉', '🥏', '🏓', '🏸', '🥊', '🥋', '🎿', '🚴',
        '😀', '😄', '😊', '😎', '🤩', '🥳', '🙂', '😉',
        '😌', '🤗', '🤔', '😤',
        '🌱', '🌿', '🍀', '🌸', '🌻', '🌈', '⭐', '🌙',
        '☀️', '🔥', '🌊', '⛰️',
        '🍎', '🍊', '🍋', '🍉', '🍓', '🍒', '🥑', '🥕',
        '🍙', '🍜', '☕', '🍫'
      ];
    }
    function keepsOrRemovesLegacyAvatarUrl() {
      return !('avatarUrl' in request.resource.data)
        || (
          ('avatarUrl' in resource.data)
          && request.resource.data.avatarUrl == resource.data.avatarUrl
        );
    }
    function canReadBattle(battleId) {
      let battle = get(/databases/$(database)/documents/battles/$(battleId));
      return signedIn() && exists(/databases/$(database)/documents/battles/$(battleId)) && (
        battle.data.type == 'public'
        || battle.data.createdBy == request.auth.uid
        || isAdmin()
        || exists(/databases/$(database)/documents/battles/$(battleId)/participants/$(request.auth.uid))
      );
    }
    function canAccessActivitySocial(activityId) {
      let activity = get(/databases/$(database)/documents/activities/$(activityId));
      let battleIds = activity.data.get('battleIds', []);
      return signedIn()
        && exists(/databases/$(database)/documents/activities/$(activityId))
        && activity.data.get('visibility', '') == 'public_v2'
        && (
          activity.data.userId == request.auth.uid
          || isAdmin()
          || (
            battleIds is list
            && battleIds.size() >= 1
            && canReadBattle(battleIds[0])
          )
          || (
            battleIds is list
            && battleIds.size() >= 2
            && canReadBattle(battleIds[1])
          )
        );
    }
    function validReaction(data, userId) {
      return data.keys().hasOnly(['type', 'userId', 'createdAt'])
        && data.userId == userId
        && data.type in ['👏', '🔥', '💪', '⚡']
        && data.createdAt == request.time;
    }

    // 課金状態・通知トークン・参加履歴を含む非公開ユーザーデータ。
    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId)
        && request.resource.data.keys().hasOnly([
          'name', 'plan', 'avatarEmoji', 'weeklyGoal',
          'runningPresenceVisible', 'runDeclarationVisible', 'createdAt', 'expoPushToken'
        ])
        && request.resource.data.keys().hasAll([
          'name', 'plan', 'runningPresenceVisible', 'createdAt'
        ])
        && request.resource.data.plan == 'free'
        && request.resource.data.createdAt is timestamp
        && validAvatarEmoji(request.resource.data)
        && validWeeklyGoal(request.resource.data.get('weeklyGoal', null))
        && validRunningPresenceSetting(request.resource.data)
        && validRunDeclarationSetting(request.resource.data)
        && validExpoPushToken(request.resource.data)
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() >= 1
        && request.resource.data.get('name', '').size() <= 40
        && safeUserText(request.resource.data.get('name', ''));
      allow update: if isSelf(userId)
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() >= 1
        && request.resource.data.get('name', '').size() <= 40
        && safeUserText(request.resource.data.get('name', ''))
        && request.resource.data.plan in ['free', 'pro']
        && keepsOrRemovesLegacyAvatarUrl()
        && validAvatarEmoji(request.resource.data)
        && validWeeklyGoal(request.resource.data.get('weeklyGoal', null))
        && validRunningPresenceSetting(request.resource.data)
        && validRunDeclarationSetting(request.resource.data)
        && validExpoPushToken(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'avatarEmoji', 'avatarUrl', 'weeklyGoal',
          'runningPresenceVisible', 'runDeclarationVisible', 'expoPushToken'
        ]);
      allow delete: if false;

      match /notifications/{notificationId} {
        allow read: if isSelf(userId);
        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead is bool;
        allow create, delete: if false;
      }

      match /badges/{badgeId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }

      match /monthlyStats/{monthId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }

      // GPSルートは本人だけが取得できる。書き込みは submitActivity の Admin SDK のみ。
      match /activityRoutes/{activityId}/{document=**} {
        allow read: if isSelf(userId);
        allow write: if false;
      }

      match /blocks/{blockedUid} {
        allow read: if isSelf(userId);
        allow create, update: if isSelf(userId)
          && blockedUid != request.auth.uid
          && request.resource.data.keys().hasOnly([
            'blockerUid', 'blockedUid', 'displayName', 'createdAt'
          ])
          && request.resource.data.blockerUid == request.auth.uid
          && request.resource.data.blockedUid == blockedUid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 1
          && request.resource.data.displayName.size() <= 40
          && request.resource.data.createdAt == request.time;
        allow delete: if isSelf(userId);
      }
    }

    // ランキング等で使う公開範囲を限定したプロフィール。
    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create: if isSelf(userId)
        && request.resource.data.keys().hasOnly(['name', 'avatarEmoji', 'updatedAt'])
        && validAvatarEmoji(request.resource.data)
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() >= 1
        && request.resource.data.get('name', '').size() <= 40
        && safeUserText(request.resource.data.get('name', ''));
      allow update: if isSelf(userId)
        && request.resource.data.keys().hasOnly(['name', 'avatarEmoji', 'avatarUrl', 'updatedAt'])
        && keepsOrRemovesLegacyAvatarUrl()
        && validAvatarEmoji(request.resource.data)
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() >= 1
        && request.resource.data.get('name', '').size() <= 40
        && safeUserText(request.resource.data.get('name', ''));
      allow delete: if false;
    }

    match /seasons/{seasonId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /battles/{battleId} {
      // list では battleId が未確定で get() が評価できないため、get と list を分ける。
      // list は resource.data ベースの条件のみ（公開チャレンジは type の絞り込みが必須）。
      allow get: if canReadBattle(battleId);
      allow list: if isAdmin()
        || (signedIn() && resource.data.type == 'public');
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'type', 'seasonId', 'title', 'description', 'categories', 'categoryIds',
          'rankingType', 'startAt', 'endAt', 'status', 'createdBy', 'inviteCode', 'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && safeUserText(request.resource.data.title)
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 200
        && safeUserText(request.resource.data.description)
        && request.resource.data.categories is list
        && request.resource.data.categories.size() >= 2
        && request.resource.data.categories.size() <= 20
        && request.resource.data.categoryIds is list
        && request.resource.data.categoryIds.size() == request.resource.data.categories.size()
        && request.resource.data.rankingType in ['average', 'total']
        && request.resource.data.startAt is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.endAt > request.resource.data.startAt
        && request.resource.data.createdBy == request.auth.uid
        // private は招待コードの一意予約を伴う createPrivateBattle だけが作成する。
        && request.resource.data.type == 'public'
        && request.resource.data.inviteCode == null
        && isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /participants/{userId} {
        allow read: if isSelf(userId) || canReadBattle(battleId);
        // 参加・チーム変更・退出は、上限と距離を原子的に検証するCallable Functionsだけが行う。
        allow create, update, delete: if isAdmin();
      }

      match /category_stats/{categoryId} {
        allow read: if canReadBattle(battleId);
        allow create: if signedIn()
          && (
            getAfter(/databases/$(database)/documents/battles/$(battleId)).data.createdBy == request.auth.uid
            || isAdmin()
          )
          && request.resource.data.keys().hasOnly([
            'totalDistanceKm', 'avgDistanceKm', 'participantCount'
          ])
          && request.resource.data.totalDistanceKm == 0
          && request.resource.data.avgDistanceKm == 0
          && request.resource.data.participantCount == 0;
        allow update, delete: if false;
      }

      match /presence/{runnerId} {
        function validPresencePayload() {
          return request.resource.data.keys().hasOnly([
              'sessionId', 'startedAt', 'lastBeatAt', 'visible'
            ])
            && request.resource.data.sessionId is string
            && request.resource.data.sessionId.size() >= 1
            && request.resource.data.sessionId.size() <= 40
            && request.resource.data.startedAt is timestamp
            && request.resource.data.startedAt <= request.time + duration.value(5, 'm')
            && request.resource.data.startedAt >= request.time - duration.value(7, 'd')
            && request.resource.data.lastBeatAt == request.time
            && request.resource.data.visible is bool;
        }
        function canPublishPresence() {
          return isSelf(runnerId)
            && isBattleParticipant(battleId)
            && get(/databases/$(database)/documents/battles/$(battleId)).data.status == 'active'
            && userDoc(runnerId).data.get('runningPresenceVisible', false) == true;
        }

        allow read: if isBattleParticipant(battleId);
        allow create: if canPublishPresence()
          && validPresencePayload()
          && request.resource.data.visible == true;
        allow update: if isSelf(runnerId)
          && isBattleParticipant(battleId)
          && validPresencePayload()
          && (
            canPublishPresence()
            || (
              request.resource.data.visible == false
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visible', 'lastBeatAt'])
            )
          );
        allow delete: if false;

        match /cheers/{fromUid} {
          function presenceDoc() {
            return get(/databases/$(database)/documents/battles/$(battleId)/presence/$(runnerId));
          }
          function validPresenceCheer() {
            return isBattleParticipant(battleId)
              && get(/databases/$(database)/documents/battles/$(battleId)).data.status == 'active'
              && fromUid == request.auth.uid
              && runnerId != request.auth.uid
              && request.resource.data.keys().hasOnly(['fromUid', 'sessionId', 'createdAt'])
              && request.resource.data.fromUid == request.auth.uid
              && request.resource.data.sessionId is string
              && request.resource.data.sessionId == presenceDoc().data.sessionId
              && request.resource.data.createdAt == request.time
              && presenceDoc().data.visible == true
              && presenceDoc().data.lastBeatAt >= request.time - duration.value(3, 'm')
              && !hasBlockBetween(request.auth.uid, runnerId);
          }

          allow read: if isBattleParticipant(battleId);
          allow create: if validPresenceCheer();
          allow update: if validPresenceCheer()
            && resource.data.sessionId != request.resource.data.sessionId;
          allow delete: if false;
        }
      }

      match /declarations/{declarationId} {
        allow get: if canReadDeclaration(battleId, resource.data);
        // 設定OFF時の一括非公開化に限り、本人のuidで絞ったcollectionGroup検索を許可する。
        allow list: if signedIn() && resource.data.uid == request.auth.uid;
        // 一覧取得は categoryId / visible / expireAt の絞り込みを必須にする。
        // owner/admin 用の分岐を混ぜると、SDK が無制約一覧を許可されたと解釈し得るため分離する。
        allow list: if isAdmin() || (
          signedIn()
          && resource.data.visible == true
          && resource.data.expireAt > request.time
          && isSameBattleCategory(battleId, resource.data.categoryId)
        );
        allow create: if isBattleParticipant(battleId)
          && get(/databases/$(database)/documents/battles/$(battleId)).data.status == 'active'
          && validFreshDeclarationV2(request.resource.data, declarationId, battleId);
        // 取消済み、または旧形式の同日ドキュメントは、新しい48時間TTL付き宣言で置換できる。
        allow update: if signedIn()
          && resource.data.uid == request.auth.uid
          && isBattleParticipant(battleId)
          && get(/databases/$(database)/documents/battles/$(battleId)).data.status == 'active'
          && (
            resource.data.status == 'cancelled'
            || resource.data.get('visible', true) == false
            || validLegacyDeclaration(resource.data, declarationId)
          )
          && validFreshDeclarationV2(request.resource.data, declarationId, battleId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.dateKey == resource.data.dateKey;
        allow update: if signedIn()
          && resource.data.uid == request.auth.uid
          && (
            // 公開OFFは退出後や終了後でも即時反映でき、他のフィールドは一切変えられない。
            (
              validDeclarationV2(resource.data, declarationId)
              && validDeclarationV2(request.resource.data, declarationId)
              && resource.data.visible == true
              && request.resource.data.visible == false
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visible'])
            )
            || (
              isBattleParticipant(battleId)
              && get(/databases/$(database)/documents/battles/$(battleId)).data.status == 'active'
              && (
                // 現行スキーマの通常編集・達成・取消。
                (
                  validDeclarationV2(resource.data, declarationId)
                  && validDeclarationV2(request.resource.data, declarationId)
                  && request.resource.data.expireAt > request.time
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'plannedAt', 'note'])
                  && (
                    (
                      resource.data.status == 'planned'
                      && request.resource.data.status in ['done', 'cancelled']
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    )
                    || (
                      resource.data.status == 'planned'
                      && request.resource.data.status == 'planned'
                      && (
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plannedAt'])
                        || (
                          request.resource.data.plannedAt >= request.time - duration.value(5, 'm')
                          && request.resource.data.plannedAt <= request.time + duration.value(24, 'h')
                        )
                      )
                    )
                  )
                )
                // デプロイ前に作られた宣言は本人の編集・取消・達成だけを維持する。
                || (
                  validLegacyDeclaration(resource.data, declarationId)
                  && validLegacyDeclaration(request.resource.data, declarationId)
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'plannedAt', 'note'])
                  && (
                    (
                      resource.data.status == 'planned'
                      && request.resource.data.status in ['done', 'cancelled']
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    )
                    || (
                      resource.data.status == 'planned'
                      && request.resource.data.status == 'planned'
                      && (
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plannedAt'])
                        || (
                          request.resource.data.plannedAt >= request.time - duration.value(5, 'm')
                          && request.resource.data.plannedAt <= request.time + duration.value(24, 'h')
                        )
                      )
                    )
                  )
                )
              )
            )
          );
        allow delete: if false;

        match /cheers/{fromUid} {
          function declarationDoc() {
            return get(/databases/$(database)/documents/battles/$(battleId)/declarations/$(declarationId));
          }
          function canAccessDeclarationCheer() {
            return exists(/databases/$(database)/documents/battles/$(battleId)/declarations/$(declarationId))
              && canReadDeclaration(battleId, declarationDoc().data);
          }

          allow read: if canAccessDeclarationCheer();
          allow create: if canAccessDeclarationCheer()
            && isSameBattleCategory(battleId, declarationDoc().data.categoryId)
            && fromUid == request.auth.uid
            && request.resource.data.keys().hasOnly(['fromUid', 'createdAt'])
            && request.resource.data.fromUid == request.auth.uid
            && request.resource.data.createdAt == request.time
            && declarationDoc().data.uid != request.auth.uid
            && declarationDoc().data.status in ['planned', 'done']
            && !hasBlockBetween(
              request.auth.uid,
              declarationDoc().data.uid
            );
          allow update: if false;
          allow delete: if declarationDoc().data.uid == request.auth.uid
            && declarationDoc().data.status == 'cancelled';
        }
      }
    }

    match /activities/{activityId} {
      // 正確な活動時刻・所属battleIds・aggregationImpactsを含む正本は本人専用。
      // 他人向け表示は認可とフィールド削減を行うCallable Functionsから返す。
      allow read: if signedIn() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      // 記録作成・集計更新は認証・内容検証を行う submitActivity / Functions のみ。
      allow create, update, delete: if false;

      match /reactions/{userId} {
        allow read: if canAccessActivitySocial(activityId);
        allow create, update: if isSelf(userId)
          && canAccessActivitySocial(activityId)
          && validReaction(request.resource.data, userId)
          && !hasBlockBetween(
            request.auth.uid,
            get(/databases/$(database)/documents/activities/$(activityId)).data.userId
          );
        allow delete: if isSelf(userId);
      }
    }

    match /battleInviteCodes/{inviteCode} {
      allow read, write: if false;
    }

    match /inviteLookupAttempts/{userId} {
      allow read, write: if false;
    }

    // 公開設定をOFFにするとき、本人の宣言だけを全チャレンジ横断で取得する。
    // collectionGroup クエリは rules_version 2 の再帰ワイルドカードで明示的に許可する必要がある。
    match /{path=**}/declarations/{declarationId} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /contentReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'reporterUid', 'targetType', 'targetId', 'targetUid', 'battleId',
          'contentSnapshot', 'reason', 'details', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetType in ['user', 'battle', 'declaration', 'presence', 'activity']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() >= 1
        && request.resource.data.targetId.size() <= 200
        && (!('targetUid' in request.resource.data) || (
          request.resource.data.targetUid is string
          && request.resource.data.targetUid.size() >= 1
          && request.resource.data.targetUid.size() <= 128
        ))
        && (!('battleId' in request.resource.data) || (
          request.resource.data.battleId is string && request.resource.data.battleId.size() <= 200
        ))
        && (!('contentSnapshot' in request.resource.data) || (
          request.resource.data.contentSnapshot is string && request.resource.data.contentSnapshot.size() <= 500
        ))
        && request.resource.data.reason in [
          'harassment', 'hate', 'sexual', 'violence', 'spam', 'impersonation', 'other'
        ]
        && (!('details' in request.resource.data) || (
          request.resource.data.details is string && request.resource.data.details.size() <= 300
        ))
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedBy', 'reviewedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['pending', 'reviewing', 'resolved', 'dismissed']
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}
