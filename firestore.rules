rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      // plan/role/titlesはCloud Functions（Admin SDK、ルール適用外）またはRevenueCat Webhookのみが変更する。
      // クライアントによる自己付与・改ざん（自己をadmin/proに昇格、称号偽造）を防ぐためupdateでの変更を禁止する。
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'role', 'titles']);

      // 通知の作成はCloud Functions（Admin SDK、ルール適用外）のみ。
      // クライアントは既読化(update)・閲覧(read)のみ行う。
      match /notifications/{notificationId} {
        allow read, update: if request.auth != null && request.auth.uid == userId;
        allow create, delete: if false;
      }
    }

    match /seasons/{seasonId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /battles/{battleId} {
      allow read: if request.auth != null;

      // パブリック戦の作成は admin のみ
      // プライベート戦の作成は Pro ユーザーのみ
      allow create: if request.auth != null && (
        (
          request.resource.data.type == 'private' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.plan == 'pro' &&
          request.resource.data.createdBy == request.auth.uid
        ) ||
        (
          request.resource.data.type == 'public' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
      allow update: if request.auth != null && (
        (resource.data.type == 'private' && resource.data.createdBy == request.auth.uid) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );

      // 参加者情報（participants/{uid}）
      // - create: 本人のみ。totalDistanceKm は必ず 0 で作成すること（距離はCloud Functionsのみが加算）
      // - update: 本人のみ。totalDistanceKm / activityCount は変更不可（カテゴリ変更等は許可）
      // - delete: 本人またはadmin
      match /participants/{userId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.totalDistanceKm == 0;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.get('totalDistanceKm', null) == resource.data.get('totalDistanceKm', null)
          && request.resource.data.get('activityCount', null) == resource.data.get('activityCount', null);
        allow delete: if request.auth != null && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
      }

      // 区分ごとの集計（category_stats/{categoryId}）
      // - read: 認証済みユーザー
      // - create: バトル作成時のゼロ初期化のみ許可（totalDistanceKm/avgDistanceKmが0）
      // - update: totalDistanceKm/avgDistanceKmの変更は不可（Cloud Functionsのみ）。
      //           participantCountの増減（参加/カテゴリ変更時）のみクライアントから許可
      // - delete: 不可
      match /category_stats/{categoryId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.totalDistanceKm == 0
          && request.resource.data.avgDistanceKm == 0;
        allow update: if request.auth != null
          && request.resource.data.totalDistanceKm == resource.data.totalDistanceKm
          && request.resource.data.avgDistanceKm == resource.data.avgDistanceKm;
        allow delete: if false;
      }
    }

    match /activities/{activityId} {
      allow read: if request.auth != null;
      // aggregated はCloud Functionsのみが付与するフィールドのため、作成時に含めることを禁止
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && !('aggregated' in request.resource.data);
      allow update, delete: if false;

      match /reactions/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
