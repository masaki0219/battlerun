{
  "expo": {
    "name": "Zelio",
    "slug": "battlerun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "zelio",
    "splash": {
      "image": "./assets/splash-background.png",
      "resizeMode": "cover",
      "backgroundColor": "#030814"
    },
    "ios": {
      "icon": "./assets/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "com.masaki.zelio",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleDisplayName": "ZELIO",
        "CFBundleAllowMixedLocalizations": true,
        "NSLocationWhenInUseUsageDescription": "ZELIO uses your location to measure running and walking distance and add it to your active challenges.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ZELIO uses your location to keep measuring distance while a recording continues in the background.",
        "NSMotionUsageDescription": "ZELIO uses motion data to count steps and estimate distance in step mode.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#030814"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "ACTIVITY_RECOGNITION"
      ],
      "package": "com.masaki.zelio",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "locales": {
      "ja": "./languages/ja.json",
      "en": "./languages/en.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["ja", "en"],
            "android": ["ja", "en"]
          }
        }
      ],
      "expo-apple-authentication",
      "./plugins/with-rnfirebase-static",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "react-native-nitro-google-signin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030814",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "ios": {
            "backgroundColor": "#030814",
            "image": "./assets/splash-background.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "backgroundColor": "#030814",
            "image": "./assets/splash-icon.png",
            "imageWidth": 220,
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#087B73",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ZELIO uses your location to keep measuring distance while a recording continues in the background.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-task-manager",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4c64c367-df9b-463c-819d-35b0ab39c5cd"
      }
    }
  }
}
