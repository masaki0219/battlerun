{
  "expo": {
    "name": "BattleRun",
    "slug": "battlerun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "battlerun",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFB"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.battlerun.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ランニング・ウォーキングの走行距離を計測し、参加中のバトルに貢献距離として反映するために位置情報を使用します。",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "アプリを閉じている間も走行距離の計測を続けるために使用します。計測は記録中のみ行われます。",
        "NSHealthShareUsageDescription": "歩数データを読み取るためにHealthKitを使用します。",
        "NSHealthUpdateUsageDescription": "運動データを記録するためにHealthKitを使用します。",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8FAFB"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "package": "com.battlerun.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#00C49A",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "アプリを閉じている間も走行距離の計測を続けるために使用します。計測は記録中のみ行われます。"
        }
      ],
      "expo-task-manager",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4c64c367-df9b-463c-819d-35b0ab39c5cd"
      }
    }
  }
}
